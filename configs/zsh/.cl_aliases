
alias x="run xwin -multiwindow"

alias xt='xterm -geometry 115x70+1 &'

alias less='less -r'                          # raw control characters
alias whence='type -a'                        # where, of a sort
alias grep='grep --color'                     # show differences in colour
alias egrep='egrep --color=auto'              # show differences in colour
alias fgrep='fgrep --color=auto'              # show differences in colour

alias grep='grep --color'
alias ls='ls -a -l --color'
alias rm='mv --force --target-directory=$HOME/.myrm'
alias vim='nvim'
alias lg='lazygit'

# Start with one editing pane when --standard is the first argument.
nvim() {
    if [[ "$1" == "--standard" ]]; then
        shift
        command nvim --cmd 'let g:standard_mode = 1' "$@"
    else
        command nvim "$@"
    fi
}

alias lla='az login && az ssh vm --ip 20.172.178.40'
